{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables default permissions for Supp",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "autostart:default",
    "allow-get-settings",
    "allow-set-close-to-tray",
    "allow-set-start-minimized",
    "allow-minimize-to-tray",
    "allow-quit-app",
    "allow-create-session-webview",
    "allow-switch-session",
    "allow-update-sidebar-bounds",
    "allow-finish-intro",
    "allow-destroy-session",
    "allow-reload-session",
    "allow-fade-session-webview",
    "allow-prepare-session-under-settings",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-open-external-url",
    "allow-copy-image-to-clipboard",
    "allow-copy-video-to-clipboard",
    "allow-show-toast"
  ]
}
