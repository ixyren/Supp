{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "whatsapp-sessions",
  "description": "Allow isolated WhatsApp Web session webviews to invoke Supp bridge commands",
  "local": false,
  "remote": {
    "urls": [
      "https://*.whatsapp.com",
      "https://whatsapp.com"
    ]
  },
  "webviews": [
    "session_*"
  ],
  "permissions": [
    "allow-report-unread",
    "allow-report-session-ready",
    "allow-report-session-avatar",
    "allow-report-webview-click",
    "allow-open-external-url",
    "allow-copy-image-to-clipboard",
    "allow-copy-video-to-clipboard"
  ]
}
