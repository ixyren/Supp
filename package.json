{
  "name": "supp",
  "productName": "Supp",
  "private": true,
  "version": "1.0.0",
  "description": "Gestor de multi-sesiones de WhatsApp",
  "author": "Javier Medina",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node \"node_modules/vite/bin/vite.js\"",
    "build": "node \"node_modules/vite/bin/vite.js\" build",
    "dist": "npm run build && node \"node_modules/electron-builder/cli.js\"",
    "lint": "eslint .",
    "preview": "node \"node_modules/vite/bin/vite.js\" preview",
    "electron:dev": "node scripts/dev.js",
    "electron:build": "npm run build && node \"node_modules/electron-builder/cli.js\"",
    "electron:build:win": "npm run build && node \"node_modules/electron-builder/cli.js\" --win",
    "electron:build:mac": "npm run build && node \"node_modules/electron-builder/cli.js\" --mac",
    "electron:build:linux": "npm run build && node \"node_modules/electron-builder/cli.js\" --linux"
  },
  "build": {
    "appId": "com.javiermedina.supp",
    "productName": "Supp",
    "copyright": "Copyright © 2025 Javier Medina",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Supp_Portable.exe",
      "requestExecutionLevel": "user"
    }
  },
  "dependencies": {
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "npm:rolldown-vite@7.2.5",
    "wait-on": "^9.0.3"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}