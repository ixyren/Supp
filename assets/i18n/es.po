msgstr "Introduce el número completo empezando por el código de país"

#: src/ui/dialogs.rs:1864
msgid "Get a code"
msgstr "Obtener código"

#: src/ui/dialogs.rs:1890
msgid "New contact"
msgstr "Nuevo contacto"

